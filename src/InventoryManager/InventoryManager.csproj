  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!--
    Single-file exe: embed the referenced DLLs, the native SQLite engines and the fonts as "bundle/..."
    resources. Bundle.cs unpacks them on first start, so InventoryManager.exe runs on its own.
  -->
  <PropertyGroup>
    <SQLiteInteropDir>$(NuGetPackageRoot)stub.system.data.sqlite.core.netframework\1.0.118\build\net45\</SQLiteInteropDir>
  </PropertyGroup>
  <Target Name="EmbedBundle" BeforeTargets="SplitResourcesByCulture" DependsOnTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(SQLiteInteropDir)x64\SQLite.Interop.dll')" Text="SQLite native engine not found in $(SQLiteInteropDir). Run a restore first." />
    <ItemGroup>
      <BundleDll Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
      <BundleFont Include="Resources\Fonts\*.ttf" />
      <EmbeddedResource Include="@(BundleDll)">
        <LogicalName>bundle/%(BundleDll.Filename)%(BundleDll.Extension)</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="$(SQLiteInteropDir)x86\SQLite.Interop.dll">
        <LogicalName>bundle/x86/SQLite.Interop.dll</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="$(SQLiteInteropDir)x64\SQLite.Interop.dll">
        <LogicalName>bundle/x64/SQLite.Interop.dll</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="@(BundleFont)">
        <LogicalName>bundle/Fonts/%(BundleFont.Filename)%(BundleFont.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
    <Message Importance="high" Text="Bundled into the exe: @(BundleDll->'%(Filename)%(Extension)'), SQLite x86/x64, fonts" />
  </Target>
